{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "apps/web/dist",
  "framework": "vite",
  "env": {
    "VITE_API_URL": "@api-url"
  },
  "functions": {
    "api/**": {
      "runtime": "nodejs20.x"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/dist/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "apps/web/dist/index.html"
    }
  ]
}
